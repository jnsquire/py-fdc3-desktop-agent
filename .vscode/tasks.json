{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Dev Dependencies",
      "type": "shell",
      "group": "build",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pip install --upgrade pip && ${workspaceFolder}\\.venv\\Scripts\\python.exe -m pip install -e '.[dev]'",
      "problemMatcher": []
    },
    {
      "label": "Run Tests (venv)",
      "type": "shell",
      "group": "test",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m pytest -q",
      "problemMatcher": []
    },
    {
      "label": "Run Agent (dev)",
      "type": "shell",
      "group": "none",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe -m uvicorn fdc3_desktop_agent.server:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "env": {
          "FDC3_ALLOWED_ORIGINS": "*",
          "FDC3_HOST": "0.0.0.0"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}